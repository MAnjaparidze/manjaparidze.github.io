---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import CaseStudy from '../../layouts/CaseStudy.astro';
import { lastModified } from '../../lib/git';

export async function getStaticPaths() {
  const studies = await getCollection('caseStudies');
  return studies.map((study) => ({ params: { slug: study.id }, props: { study } }));
}

interface Props {
  study: CollectionEntry<'caseStudies'>;
}

const { study } = Astro.props;
const { Content } = await render(study);
// Never earlier than the publish date: git times are UTC, datePublished is a local calendar day.
const dateModified = new Date(Math.max(lastModified(study.filePath ?? '').getTime(), study.data.datePublished.getTime()));
---

<CaseStudy {...study.data} dateModified={dateModified}>
  <Content />
</CaseStudy>
