---
import PageIntro from '../components/PageIntro.astro';
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page doesn't exist." ogCard="home">
  <div class="mx-auto max-w-page px-5 pb-18 sm:px-8 lg:pb-24">
    <PageIntro
      label="404"
      title="This page doesn't exist."
      lead="The link may be old, or the address mistyped. Everything on this site is one step from the homepage."
    />
    <ul class="flex flex-wrap items-center gap-x-7 gap-y-3">
      <li>
        <a
          href="/"
          class="inline-flex min-h-12 items-center rounded-md bg-accent px-6 font-semibold text-on-accent no-underline hover:bg-ink hover:text-ground"
        >
          Go to the homepage
        </a>
      </li>
      <li><a href="/#work" class="inline-flex min-h-12 items-center font-medium underline">See selected work</a></li>
    </ul>
    {
      /*
       * GitHub Pages serves this one file for every missing URL, /ka/ ones included, so it points Georgian readers on.
       * Georgian drafted by Claude for Mamuka's review (2026-10-02), like src/i18n/ui.ts. It uses the system's
       * Georgian font: the Noto faces load only on /ka/ pages, which isn't worth a download for one line.
       */
    }
    <p lang="ka" class="mt-8 flex flex-wrap items-center gap-x-3 text-muted">
      ეს გვერდი არ არსებობს.
      <a href="/ka/" class="inline-flex min-h-12 items-center font-medium underline">გადადით ქართულ მთავარ გვერდზე</a>
    </p>
  </div>
</Base>
