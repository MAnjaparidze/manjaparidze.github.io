---
import { Font } from 'astro:assets';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { ogSlug } from '../lib/og';
import { SITE } from '../lib/site';
import { THEME_STORAGE_KEY } from '../lib/theme';
import '../styles/global.css';

interface Props {
  /** Page title without the site name; omit on the homepage. */
  title?: string;
  description?: string;
  /** Footer "Have an app to ship?" CTA; off on pages that already lead with it. */
  footerCta?: boolean;
  /** Open Graph type: "article" for case studies. */
  ogType?: 'website' | 'article';
  /** Preview card slug (src/pages/og/[slug].png.ts); derived from the path unless the page has no card of its own. */
  ogCard?: string;
}

const { title, description = SITE.description, footerCta = true, ogType = 'website', ogCard } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.jobTitle}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`/og/${ogCard ?? ogSlug(Astro.url.pathname)}.png`, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Applies a saved theme before first paint; must stay inline and blocking to avoid a flash. -->
    <script is:inline define:vars={{ key: THEME_STORAGE_KEY }}>
      try {
        const theme = localStorage.getItem(key);
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {
        // Storage blocked: the OS setting decides.
      }
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Browser UI color; mirrors --color-ground in global.css. -->
    <meta name="theme-color" content="#f6f7f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1116" media="(prefers-color-scheme: dark)" />

    <Font cssVariable="--font-newsreader" preload />
    <Font cssVariable="--font-plex-sans" preload={[{ weight: 400, style: 'normal' }]} />
    <Font cssVariable="--font-plex-mono" />

    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only z-50 bg-surface px-4 py-3 font-medium text-ink focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Skip to content
    </a>
    <SiteHeader />
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <SiteFooter cta={footerCta} />
  </body>
</html>
