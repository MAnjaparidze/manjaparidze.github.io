---
/**
 * Case study page: intro + meta, then the MDX body as an <article>.
 * "Last updated" comes from git (lib/git.ts), never from frontmatter.
 */
import Base from './Base.astro';
import { localePath, toLang } from '../i18n';
import { ui } from '../i18n/ui';
import { techArticleSchema } from '../lib/schema';

interface Props {
  title: string;
  summary: string;
  role: string;
  stack: readonly string[];
  status: string;
  topics: readonly string[];
  datePublished: Date;
  dateModified: Date;
  links?: readonly { label: string; href: string }[];
}

const { title, summary, role, stack, status, topics, datePublished, dateModified, links = [] } = Astro.props;
const lang = toLang(Astro.currentLocale);
const t = ui(lang);
const site = Astro.site ?? new URL(Astro.url.origin);
const schema = techArticleSchema(site, new URL(Astro.url.pathname, site), {
  headline: title,
  description: summary,
  datePublished,
  dateModified,
  about: topics,
  inLanguage: lang,
});
const formatDate = (date: Date): string =>
  date.toLocaleDateString(t.dateLocale, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const meta = [
  { term: t.caseStudy.role, detail: role },
  { term: t.caseStudy.stack, detail: stack.join(' · ') },
  { term: t.caseStudy.status, detail: status },
];
---

<Base title={title} description={summary} ogType="article">
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  <meta slot="head" property="article:published_time" content={datePublished.toISOString()} />
  <meta slot="head" property="article:modified_time" content={dateModified.toISOString()} />

  <article class="mx-auto max-w-page px-5 pb-18 sm:px-8 lg:pb-24">
    <header class="flex flex-col gap-5 pt-14 pb-10 lg:gap-7 lg:pt-24 lg:pb-14">
      <p class="font-mono text-[0.8125rem] tracking-[0.02em] text-muted">
        <a href={localePath(lang, '/#work')} class="text-muted hover:text-ink">{t.selectedWork}</a>
        <span aria-hidden="true"> / </span>{t.caseStudy.label}
      </p>
      <h1
        class="max-w-[50rem] font-serif text-[2.5rem] leading-[1.05] font-medium tracking-[-0.02em] [overflow-wrap:break-word] max-sm:[&:lang(ka)]:text-[2rem] sm:text-6xl sm:[&:lang(ka)]:text-5xl"
      >
        {title}
      </h1>
      <p class="max-w-prose-col text-lg leading-relaxed text-muted lg:text-xl">{summary}</p>
      <dl class="grid max-w-prose-col gap-x-8 gap-y-3 border-t border-rule pt-6 sm:grid-cols-[8rem_minmax(0,1fr)]">
        {
          meta.map(({ term, detail }) => (
            <>
              <dt class="font-mono text-[0.8125rem] tracking-[0.02em] text-muted sm:pt-0.5">{term}</dt>
              <dd class="-mt-2 sm:mt-0">{detail}</dd>
            </>
          ))
        }
        {
          links.length > 0 && (
            <>
              <dt class="font-mono text-[0.8125rem] tracking-[0.02em] text-muted sm:pt-0.5">{t.caseStudy.links}</dt>
              <dd class="-mt-2 sm:mt-0">
                <ul class="flex flex-wrap gap-x-4 gap-y-1">
                  {links.map(({ label, href }) => (
                    <li>
                      <a {href}>{label}</a>
                    </li>
                  ))}
                </ul>
              </dd>
            </>
          )
        }
        <dt class="font-mono text-[0.8125rem] tracking-[0.02em] text-muted sm:pt-0.5">{t.caseStudy.updated}</dt>
        <dd class="-mt-2 sm:mt-0"><time datetime={dateModified.toISOString()}>{formatDate(dateModified)}</time></dd>
      </dl>
    </header>

    <div class="case-body">
      <slot />
    </div>
  </article>
</Base>
