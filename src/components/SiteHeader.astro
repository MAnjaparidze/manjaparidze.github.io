---
import { NAV, SITE } from '../lib/site';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isCurrent = (href: string): boolean => path === href || path.startsWith(href);
---

<header class="mx-auto flex w-full max-w-page flex-wrap items-center justify-between gap-x-8 gap-y-2 px-5 py-4 sm:px-8 sm:py-7">
  <a href="/" class="font-serif text-xl font-medium text-ink no-underline sm:text-[1.375rem]" aria-current={path === '/' ? 'page' : undefined}>
    {SITE.name}
  </a>
  <div class="-mr-3 flex items-center gap-x-2">
    <nav aria-label="Main">
      <ul class="-ml-3 flex flex-wrap">
        {
          NAV.map(({ label, href }) => (
            <li>
              <a
                href={href}
                aria-current={isCurrent(href) ? 'page' : undefined}
                class="inline-flex min-h-11 items-center px-3 text-[0.9375rem] text-ink no-underline hover:underline aria-[current=page]:underline"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>
