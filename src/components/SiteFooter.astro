---
/** Site-wide closing CTA, then public profiles. The CV link joins PROFILES once the PDF exists. */
import ContactActions from './ContactActions.astro';
import { PROFILES } from '../lib/site';
---

<footer class="border-t border-rule bg-surface">
  <div class="mx-auto flex max-w-page flex-col gap-7 px-5 pt-14 pb-10 sm:px-8 lg:pt-24 lg:pb-14">
    <p class="font-serif text-[2.125rem] leading-tight font-medium tracking-[-0.01em] lg:text-[3.5rem]">
      Have an app to ship?
    </p>
    <ContactActions />
    <ul class="-mx-3 flex flex-wrap pt-4 font-mono text-[0.8125rem]">
      {
        PROFILES.map(({ label, href }) => (
          <li>
            <a href={href} rel="me" class="inline-flex min-h-11 items-center px-3 text-muted hover:text-ink">
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
