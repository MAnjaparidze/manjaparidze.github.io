---
import { PROFILES, SITE } from '../lib/site';
---

<footer class="border-t border-rule bg-surface">
  <div class="mx-auto flex max-w-page flex-wrap items-center justify-between gap-x-8 gap-y-4 px-5 py-10 sm:px-8">
    <p class="font-serif text-lg">{SITE.name}</p>
    <ul class="-mx-3 flex flex-wrap font-mono text-[0.8125rem]">
      {
        PROFILES.map(({ label, href }) => (
          <li>
            <a href={href} rel="me" class="inline-flex min-h-11 items-center px-3 text-muted hover:text-ink">
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
