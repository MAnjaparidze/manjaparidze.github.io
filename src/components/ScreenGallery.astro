---
/** A row of screens that scrolls sideways; each keeps a readable size instead of shrinking. `desktop` for website screenshots. */
import { Picture } from 'astro:assets';
import type { ScreenImage } from '../lib/screens';
import { toLang } from '../i18n';
import { ui } from '../i18n/ui';

interface Props {
  /** Accessible name for the scroll region. */
  label: string;
  screens: readonly ScreenImage[];
  caption: string;
  variant?: 'phone' | 'desktop';
  /** Desktop only: 2:1 frames for wide page screenshots instead of 4:3. */
  wide?: boolean;
}

const { label, screens, caption, variant = 'phone', wide = false } = Astro.props;
const desktop = variant === 'desktop';
const lang = toLang(Astro.currentLocale);
const t = ui(lang);
---

<figure>
  <div class="-mx-5 overflow-x-auto px-5 pb-3 [scrollbar-color:var(--color-rule)_transparent] [scrollbar-width:thin] sm:mx-0 sm:px-0" role="region" tabindex="0" aria-label={`${label}, ${t.scrollable}`}>
    <ul class="flex snap-x snap-mandatory gap-4">
      {
        screens.map(({ label: screenLabel, image, alt }) => (
          <li class:list={['flex shrink-0 snap-start flex-col gap-2', desktop ? 'w-80 sm:w-[30rem]' : 'w-44 sm:w-48']}>
            <div class:list={[desktop && 'flex items-center justify-center overflow-hidden rounded-lg border border-rule bg-shot p-2', desktop && (wide ? 'aspect-[2/1]' : 'aspect-[4/3]')]}>
              <Picture
                src={image}
                alt={alt[lang]}
                formats={['avif', 'webp']}
                widths={desktop ? [320, 480, 640, 960] : [180, 360, 540]}
                sizes={desktop ? '(min-width: 640px) 480px, 320px' : '(min-width: 640px) 192px, 176px'}
                class:list={desktop ? 'max-h-full w-full object-contain' : 'h-auto w-full rounded-[1.25rem] border border-rule'}
              />
            </div>
            <span class="font-mono text-[0.8125rem] text-muted">{screenLabel[lang]}</span>
          </li>
        ))
      }
    </ul>
  </div>
  <figcaption>{caption}</figcaption>
</figure>
