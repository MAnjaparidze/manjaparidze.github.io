---
/** One "Websites and web apps" entry: title | description, stack and a link to the public evidence. */
import ScreenGallery from './ScreenGallery.astro';
import { toLang, translatedPath } from '../i18n';
import { ui } from '../i18n/ui';
import type { WebWork } from '../lib/work';

type Props = WebWork;

const { slug, title, context, description, stack, link, gallery } = Astro.props;
const headingId = `web-${slug}`;
const lang = toLang(Astro.currentLocale);
const t = ui(lang);
const external = link.href.startsWith('http');
// Internal links go to this page's language when that version exists; otherwise say it's in English.
const href = external ? link.href : (translatedPath(lang, link.href) ?? link.href);
const englishOnly = !external && lang !== 'en' && translatedPath(lang, link.href) === undefined;
---

<article aria-labelledby={headingId} class="grid gap-3 border-t border-rule py-8 md:grid-cols-2 md:gap-12 lg:py-10">
  <div class="flex flex-col gap-2">
    <p class="font-mono text-[0.8125rem] tracking-[0.02em] text-muted">{context[lang]}</p>
    <h3 id={headingId} class="font-serif text-[1.75rem] leading-tight font-medium lg:text-[2.25rem]">{title[lang]}</h3>
  </div>
  <div class="flex flex-col gap-4 md:pt-6">
    <p class="max-w-prose-col text-[1.0625rem] leading-relaxed">{description[lang]}</p>
    <ul class="flex flex-wrap gap-x-2 font-mono text-[0.8125rem] leading-relaxed tracking-[0.02em] text-muted">
      {stack.map((item, i) => <li>{i > 0 && <span aria-hidden="true">· </span>}{item}</li>)}
    </ul>
    <a
      href={href}
      rel={external ? 'noopener' : undefined}
      class="inline-flex min-h-11 items-center self-start font-medium underline"
    >
      {link.label[lang]}
      {englishOnly && t.englishOnly}
      {external && <span class="sr-only"> {t.externalSite}</span>}
    </a>
  </div>
  {
    gallery && (
      <div class="min-w-0 md:col-span-2 [&_figcaption]:mt-3 [&_figcaption]:font-mono [&_figcaption]:text-[0.8125rem] [&_figcaption]:text-muted">
        <ScreenGallery
          label={t.screenshots(title[lang])}
          screens={gallery.screens}
          caption={gallery.caption[lang]}
          variant="desktop"
        />
      </div>
    )
  }
</article>
