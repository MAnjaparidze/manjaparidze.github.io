---
/**
 * UKar dispatch as a sequence diagram: closest-first offers, the atomic accept, then live tracking.
 * Theme tokens only, so it follows light/dark; scrolls sideways below ~36rem.
 */
import { toLang } from '../../i18n';

const lang = toLang(Astro.currentLocale);
/** English or Georgian; tech names (Node.js, MongoDB, Socket.IO) stay as they are in both. */
const L = (en: string, ka: string): string => (lang === 'ka' ? ka : en);
const lanes = [
  { x: 90, title: L('Customer app', 'მომხმარებელი') },
  { x: 290, title: 'API' },
  { x: 490, title: L('Car wash A', 'სამრეცხაო A') },
  { x: 650, title: L('Car wash B', 'სამრეცხაო B') },
];

/** from/to are lane x positions; dashed = reply or no-op. */
const steps = [
  { y: 96, from: 90, to: 290, label: L('Request a wash', 'რეცხვის მოთხოვნა') },
  { y: 144, from: 290, to: 490, label: L('Offer (closest first, 30 s)', 'შეთავაზება (უახლოესს, 30 წმ)') },
  { y: 192, from: 490, to: 490, label: L('No answer: offer expires', 'უპასუხოდ: ვადა გავიდა'), note: true },
  { y: 240, from: 290, to: 650, label: L('Offer to next closest (30 s)', 'შემდეგ უახლოესს (30 წმ)') },
  { y: 288, from: 650, to: 290, label: L('Accept', 'მიღება') },
  { y: 336, from: 290, to: 650, label: L('200 won · a second tap gets 409', '200 მიიღო · მეორე დაჭერა: 409'), dashed: true },
  { y: 384, from: 290, to: 90, label: L('Accepted · live location and ETA', 'მიღებულია · ლოკაცია და ETA'), dashed: true },
];
---

<figure>
  <div class="overflow-x-auto rounded-lg border border-rule bg-surface p-5" tabindex="0" aria-label={L('UKar dispatch sequence diagram, scrollable', 'UKar-ის დისპეჩერიზაციის დიაგრამა, გადაადგილებადი')}>
    <svg viewBox="0 0 740 440" class="w-full min-w-[34rem] text-ink" role="img" aria-labelledby="ukar-dispatch-title ukar-dispatch-desc">
      <title id="ukar-dispatch-title">{L('How a UKar request is dispatched', 'როგორ ნაწილდება UKar-ის მოთხოვნა')}</title>
      <desc id="ukar-dispatch-desc">
        {
          L(
            'The customer app requests a wash. The API offers it to the closest available car wash for 30 seconds. If that wash doesn\'t answer, the offer goes to the next closest, for up to 10 minutes in total. The wash that accepts wins through an atomic database update; a second, simultaneous accept gets a 409 conflict. The API then tells the customer app the wash was accepted and streams live location and ETA.',
            'მომხმარებლის აპლიკაცია რეცხვას ითხოვს. API მოთხოვნას 30 წამით უახლოეს თავისუფალ სამრეცხაოს სთავაზობს. თუ ის არ პასუხობს, შეთავაზება შემდეგ უახლოესზე გადადის, ჯამში 10 წუთამდე. იგებს ის სამრეცხაო, რომელიც პირველი მიიღებს: ეს ერთი ატომური ჩანაწერია ბაზაში, მეორე ერთდროული მიღება კი 409 შეცდომას იღებს. შემდეგ API მომხმარებლის აპლიკაციას ატყობინებს, რომ მოთხოვნა მიღებულია, და ლოკაციასა და ETA-ს რეალურ დროში გადასცემს.',
          )
        }
      </desc>

      <defs>
        <marker id="ukar-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0 0 L10 5 L0 10 z" class="fill-muted" />
        </marker>
      </defs>

      <g class="font-sans" font-size="12.5">
        {
          lanes.map(({ x, title }) => (
            <g>
              <rect x={x - 70} y="8" width="140" height="40" rx="8" class="fill-panel stroke-rule" />
              <text {x} y="33" text-anchor="middle" class="fill-ink font-serif" font-size="15">{title}</text>
              <line x1={x} y1="48" x2={x} y2="420" class="stroke-rule" stroke-dasharray="3 5" />
            </g>
          ))
        }

        {
          steps.map(({ y, from, to, label, dashed, note }) =>
            note ? (
              <g>
                <rect x={to - 88} y={y - 16} width="176" height="28" rx="6" class="fill-panel stroke-rule" />
                <text x={to} {y} dy="3" text-anchor="middle" class="fill-muted font-mono" font-size="11">{label}</text>
              </g>
            ) : (
              <g>
                <line
                  x1={from}
                  y1={y}
                  x2={to + (to > from ? -4 : 4)}
                  y2={y}
                  class="stroke-muted"
                  stroke-dasharray={dashed ? '5 4' : undefined}
                  marker-end="url(#ukar-arrow)"
                />
                <text x={(from + to) / 2} y={y - 8} text-anchor="middle" class="fill-ink" font-size="12.5">{label}</text>
              </g>
            ),
          )
        }

        <text x="290" y="436" text-anchor="middle" class="fill-muted font-mono" font-size="11">
          {L('Offers stop after 10 minutes in total', 'შეთავაზებები ჯამში 10 წუთის შემდეგ წყდება')}
        </text>
      </g>
    </svg>
  </div>
  <figcaption>
    {
      L(
        "Closest-first offers, then an atomic accept: two partners can't both win the same wash.",
        'შეთავაზება ჯერ უახლოესს, შემდეგ ატომური მიღება: ორი პარტნიორი ერთსა და იმავე რეცხვას ვერ მიიღებს.',
      )
    }
  </figcaption>
</figure>
