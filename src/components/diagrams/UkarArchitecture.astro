---
/**
 * UKar system architecture. Colors are theme tokens, so it follows light/dark with the page.
 * Below ~36rem the figure scrolls sideways instead of shrinking the labels past legibility.
 */
const clients = [
  { x: 0, title: 'Customer app', lines: ['React Native · Expo', 'iOS · Android · Yandex Maps'] },
  { x: 256, title: 'Partner app', lines: ['React Native · Expo', 'Owners · admins · washers'] },
  { x: 512, title: 'Admin dashboard', lines: ['React · TypeScript', 'Partner approval · reviews'] },
];
const services = [
  { x: 0, y: 293, title: 'SMS one-time codes' },
  { x: 0, y: 369, title: 'Yandex MapKit · Geocoder' },
  { x: 512, y: 293, title: 'Expo push' },
  { x: 512, y: 369, title: 'DigitalOcean Spaces (images)' },
];
---

<figure>
  <div class="overflow-x-auto rounded-lg border border-rule bg-surface p-5" tabindex="0" aria-label="UKar architecture diagram, scrollable">
    <svg
      viewBox="0 0 720 436"
      class="w-full min-w-[34rem] text-ink"
      role="img"
      aria-labelledby="ukar-arch-title ukar-arch-desc"
    >
      <title id="ukar-arch-title">UKar architecture</title>
      <desc id="ukar-arch-desc">
        Three clients, the customer app, the partner app and the admin dashboard, talk to one Node.js and Express API
        over REST and Socket.IO. The API stores data in MongoDB and uses external services: SMS one-time codes,
        Yandex MapKit and Geocoder, Expo push notifications, and DigitalOcean Spaces for images.
      </desc>

      <g class="font-sans" font-size="13">
        {
          clients.map(({ x, title, lines }) => (
            <g>
              <rect x={x + 1} y="1" width="206" height="86" rx="8" class="fill-panel stroke-rule" />
              <text x={x + 16} y="28" class="fill-ink font-serif" font-size="17">{title}</text>
              {lines.map((line, i) => (
                <text x={x + 16} y={52 + i * 20} class="fill-muted font-mono" font-size="11.5">{line}</text>
              ))}
              <line x1={x + 104} y1="88" x2={x + 104} y2="152" class="stroke-muted" stroke-dasharray="4 4" />
            </g>
          ))
        }

        <text x="372" y="126" class="fill-muted font-mono" font-size="11.5">REST + Socket.IO</text>

        <rect x="1" y="153" width="718" height="76" rx="8" class="fill-surface stroke-ink" stroke-width="1.5" />
        <text x="360" y="186" text-anchor="middle" class="fill-ink font-serif" font-size="18">Node.js · Express API</text>
        <text x="360" y="210" text-anchor="middle" class="fill-muted font-mono" font-size="11.5">
          Real-time dispatch over Socket.IO · closest-first job offers · live ETA
        </text>

        <line x1="360" y1="230" x2="360" y2="292" class="stroke-muted" stroke-dasharray="4 4" />
        <line x1="104" y1="230" x2="104" y2="292" class="stroke-muted" stroke-dasharray="4 4" />
        <line x1="616" y1="230" x2="616" y2="292" class="stroke-muted" stroke-dasharray="4 4" />

        <rect x="257" y="293" width="206" height="64" rx="8" class="fill-panel stroke-rule" />
        <text x="360" y="321" text-anchor="middle" class="fill-ink font-serif" font-size="17">MongoDB</text>
        <text x="360" y="342" text-anchor="middle" class="fill-muted font-mono" font-size="11.5">Washes · partners · reviews</text>

        {
          services.map(({ x, y, title }) => (
            <g>
              <rect x={x + 1} {y} width="206" height="56" rx="8" class="fill-surface stroke-rule" stroke-dasharray="4 3" />
              <text x={x + 104} y={y + 33} text-anchor="middle" class="fill-ink" font-size="13">{title}</text>
            </g>
          ))
        }
      </g>
    </svg>
  </div>
  <figcaption>
    One backend, three clients. Dashed boxes are external services.
  </figcaption>
</figure>
