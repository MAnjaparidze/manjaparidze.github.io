---
/**
 * Light/dark switch. Hidden until its script runs, since it does nothing without JS.
 * The OS setting decides by default; a click that lands back on the OS theme clears the override.
 */
import { toLang } from '../i18n';
import { ui } from '../i18n/ui';

const t = ui(toLang(Astro.currentLocale));
---

<button
  type="button"
  data-theme-toggle
  aria-pressed="false"
  hidden
  class="inline-flex min-h-11 min-w-11 cursor-pointer items-center justify-center text-ink transition-colors duration-150 hover:text-accent"
>
  <span class="sr-only">{t.darkTheme}</span>
  <!-- Sun in light mode, moon in dark mode: switched by CSS so there is no flash on load. -->
  <svg
    aria-hidden="true"
    class="size-5 dark:hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
    ></path>
  </svg>
  <svg
    aria-hidden="true"
    class="hidden size-5 dark:block"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z"></path>
  </svg>
</button>

<script>
  import { THEME_STORAGE_KEY, type Theme } from '../lib/theme';

  const root = document.documentElement;
  const osDark = window.matchMedia('(prefers-color-scheme: dark)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const themeColors = document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]');
  // Original per-scheme values from Base.astro, restored when the OS decides again.
  const defaultThemeColors = [...themeColors].map((meta) => meta.content);

  const osTheme = (): Theme => (osDark.matches ? 'dark' : 'light');
  const currentTheme = (): Theme => {
    const forced = root.dataset.theme;
    return forced === 'light' || forced === 'dark' ? forced : osTheme();
  };

  /** Keeps the browser UI color and every toggle's pressed state in line with the page. */
  function sync(): void {
    const forced = root.dataset.theme !== undefined;
    const ground = getComputedStyle(document.body).backgroundColor;
    themeColors.forEach((meta, i) => {
      meta.content = forced ? ground : (defaultThemeColors[i] ?? meta.content);
    });
    const pressed = String(currentTheme() === 'dark');
    document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
      button.setAttribute('aria-pressed', pressed);
    });
  }

  function applyTheme(theme: Theme): void {
    const followOs = theme === osTheme();
    if (followOs) delete root.dataset.theme;
    else root.dataset.theme = theme;
    try {
      if (followOs) localStorage.removeItem(THEME_STORAGE_KEY);
      else localStorage.setItem(THEME_STORAGE_KEY, theme);
    } catch {
      // Storage blocked (private mode, site data off): the choice lasts for this page only.
    }
    sync();
  }

  /** Crossfades the switch where the browser can; otherwise, or with reduced motion, it just changes. */
  function setTheme(theme: Theme): void {
    if (!document.startViewTransition || reducedMotion.matches) applyTheme(theme);
    else document.startViewTransition(() => applyTheme(theme));
  }

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
    button.hidden = false;
    button.addEventListener('click', () => setTheme(currentTheme() === 'dark' ? 'light' : 'dark'));
  });
  osDark.addEventListener('change', sync);
  sync();
</script>
