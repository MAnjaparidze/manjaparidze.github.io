---
/** The homepage, in either language: rendered by src/pages/index.astro and src/pages/ka/index.astro. */
import ContactActions from '../components/ContactActions.astro';
import RuleList from '../components/RuleList.astro';
import WebWorkItem from '../components/WebWorkItem.astro';
import WorkFeature from '../components/WorkFeature.astro';
import { toLang, type Localized } from '../i18n';
import { ui } from '../i18n/ui';
import Base from '../layouts/Base.astro';
import { personSchema } from '../lib/schema';
import { SITE } from '../lib/site';
import { EARLIER_WORK, FEATURED_WORK, WEB_WORK } from '../lib/work';

const lang = toLang(Astro.currentLocale);
const t = ui(lang);
// `site` is always set in astro.config.mjs; the fallback only satisfies the type.
const schema = personSchema(Astro.site ?? new URL(Astro.url.origin));

const HERO: { headline: Localized; lead: Localized } = {
  headline: {
    en: 'When customers ask Google or ChatGPT, your business should be the answer.',
    ka: 'როცა მომხმარებელი Google-ს ან ChatGPT-ს ეკითხება, პასუხი თქვენი ბიზნესი უნდა იყოს.',
  },
  lead: {
    en: "I build websites and apps that search engines and AI assistants can read, trust and recommend, for e-commerce and growing companies. At Coinmania I've been the founding engineer of a crypto app whose platform serves 150–200k active users.",
    ka: 'ვქმნი ვებსაიტებსა და აპლიკაციებს ელ-კომერციისა და მზარდი კომპანიებისთვის ისე, რომ საძიებო სისტემებმა და AI ასისტენტებმა შეძლონ მათი წაკითხვა, ენდონ და მომხმარებლებს ურჩიონ. Coinmania-ში კრიპტო აპლიკაციის დამფუძნებელი ინჟინერი ვარ; პლატფორმას 150–200 ათასი აქტიური მომხმარებელი ჰყავს.',
  },
};
---

<Base>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

  <div class="mx-auto max-w-page px-5 pb-18 sm:px-8 lg:pb-34">
    <section aria-labelledby="hero-title" class="flex flex-col gap-6 pt-14 pb-18 lg:gap-9 lg:pt-32 lg:pb-34">
      <p class="font-mono text-[0.8125rem] tracking-[0.02em] text-muted">
        {t.jobTitle} · {t.currentlyAt(SITE.currently)}
      </p>
      <h1
        id="hero-title"
        class="max-w-[65rem] font-serif text-[2.75rem] leading-[1.02] font-medium tracking-[-0.02em] [overflow-wrap:break-word] max-sm:[&:lang(ka)]:text-[2.125rem] sm:text-7xl sm:[&:lang(ka)]:text-[3.25rem] lg:text-[5rem] lg:[&:lang(ka)]:text-[4.25rem]"
      >
        {HERO.headline[lang]}
      </h1>
      <p class="max-w-[40rem] text-lg leading-relaxed text-muted lg:text-xl">{HERO.lead[lang]}</p>
      <ContactActions />
    </section>

    <section id="work" aria-labelledby="work-title" class="flex flex-col gap-14 lg:gap-24">
      <h2 id="work-title" class="border-b border-rule pb-4 font-mono text-[0.8125rem] tracking-[0.02em] text-muted">
        {t.selectedWork}
      </h2>
      {FEATURED_WORK.map((work) => <WorkFeature {...work} />)}
    </section>

    <section id="web" aria-labelledby="web-title" class="flex flex-col pt-18 lg:pt-34">
      <h2 id="web-title" class="pb-6 font-serif text-3xl font-medium lg:text-[2.5rem]">{t.webWork}</h2>
      <div class="border-b border-rule">
        {WEB_WORK.map((work) => <WebWorkItem {...work} />)}
      </div>
    </section>

    <section aria-labelledby="earlier-title" class="flex flex-col gap-6 pt-18 lg:pt-34">
      <h2 id="earlier-title" class="font-serif text-3xl font-medium lg:text-[2.5rem]">{t.earlierWork}</h2>
      <RuleList items={EARLIER_WORK.map(({ domain, items }) => ({ term: domain[lang], detail: items[lang].join(' · ') }))} />
    </section>
  </div>
</Base>
